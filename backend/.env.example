# ============================================================
# 汇诊后端配置（环境变量覆盖示例）
# 复制为 .env 并按部署环境修改。生产部署必须显式设置：
#   SECRET_KEY（≥32 字节随机串）、PHI_ENCRYPTION_KEY（Fernet key）、LLM_API_KEY
# ============================================================

# --- 数据库 ---
# SQLite（默认）：sqlite:///./data/medconsult.db
# 生产推荐 PostgreSQL：postgresql+psycopg://user:pass@host:5432/medconsult
DATABASE_URL=sqlite:///./data/medconsult.db

# --- 安全 ---
# JWT 签名密钥（生产必须改为随机长串，勿用默认值）
SECRET_KEY=please-change-me-to-a-random-32byte-string!
# PHI 加密密钥：留空时开发环境自动生成并保存到 data/.phi_key；
# 生产必须显式指定（可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成）
# PHI_ENCRYPTION_KEY=

# --- 种子管理员（仅首次启动建库时生效）---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
# 多机构隔离：用户注册/管理员建号时可指定 hospital；
# 医生默认仅见自己创建的数据；配置了 hospital 时同机构同事数据互相可见。
# 主任/管理员始终可见全院数据。

# --- LLM 接入（OpenAI 兼容 API 为主；Ollama 仅内网兜底）---
# 不配置 LLM 时，会诊将拒绝生产模式请求（仅沙箱演示可用）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_DEFAULT_MODEL=glm-4.5-air
# LLM_TIMEOUT_SECONDS=90
# 可覆盖默认 LLM 配置（多模型时使用）
# LLM_SPECIALIST_MODEL=
# LLM_MODERATOR_MODEL=

# --- 运行模式 ---
# true=开发（CORS 放行 5173、允许无 LLM 沙箱）；false=生产
DEBUG=true
# 生产模式下，即使未配置 LLM 也允许沙箱演示会诊
ALLOW_SANDBOX_WITHOUT_LLM=true

# --- 反向代理（企业部署必读）---
# 部署在 nginx/网关后置为 true，此时才信任 X-Forwarded-For（限流/审计取真实客户端 IP）。
# 默认 false：以直连 socket 地址为准，防止伪造头绕过限流。
# BEHIND_PROXY=false

# --- 限流与账号安全 ---
# API_RATE_LIMIT_PER_MINUTE=300
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# LOGIN_FAIL_THRESHOLD=5
# LOGIN_LOCK_SECONDS=900
# PASSWORD_MIN_LENGTH=10

# --- 医院信息（展示于报告抬头）---
HOSPITAL_NAME=汇诊会诊中心

# --- 多模态工具层（OCR/ASR/TTS）---
# 不填则自动用本地工具兜底：OCR=rapidocr-onnxruntime，ASR=faster-whisper，TTS=edge-tts
# OCR_API_URL 支持 OpenAI 兼容 vision 接口（base_url 或 .../chat/completions）
# OCR_API_URL=
# OCR_API_KEY=
# OCR_API_MODEL=
# ASR_API_URL 支持 OpenAI 兼容 /audio/transcriptions
# ASR_API_URL=
# ASR_API_KEY=
# ASR_API_MODEL=whisper-1
# TTS_API_URL 支持 OpenAI 兼容 /audio/speech
# TTS_API_URL=
# TTS_API_KEY=
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# 媒体/文档存储目录（相对数据库所在目录，例如 backend/data/media、backend/data/documents）
# MEDIA_STORAGE_DIR=media
