{
  "_说明": "复制本文件为 config.json（已被 .gitignore 忽略）后填写。前端设置里留空的项会自动使用这里的默认值。也支持环境变量 MEDCONSULT_API_KEY / MEDCONSULT_BASE_URL / MEDCONSULT_MODEL 覆盖。",

  "_示例1_GLM官方": {
    "api_key": "你的智谱API密钥（open.bigmodel.cn 申请）",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-4.5-air"
  },
  "_示例2_DeepSeek": {
    "api_key": "sk-...",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat"
  },
  "_示例3_本地Ollama": {
    "api_key": "ollama",
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "qwen2.5:1.5b-instruct"
  },

  "api_key": "sk-your-api-key-here",
  "base_url": "https://api.deepseek.com/v1",
  "model": "deepseek-chat",
  "hospital_name": "XX医院（报告抬头与打印用，可留空）",
  "hospital_policy": "本院规范（选填，注入每个会诊智能体）：如——抗凝药物仅限目录内品种；出院带药不超过14天；会诊报告需注明建议复查时间。",
  "report_footer": "打印报告页脚备注（选填）"
}
